# Copy to .env.local for local runs (never commit it). On Vercel, add these under Project → Settings → Environment Variables.

# Chat model (Claude)
ANTHROPIC_API_KEY=

# Embeddings for research search (OpenAI text-embedding-3-small)
OPENAI_API_KEY=

# Optional locally, required in production: Supabase project with supabase/migrations applied.
# Without these, ingest writes data/index.json and the app searches that file instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
