# Copy to .env.local for local runs (never commit it). On Vercel, add it under Project → Settings → Environment Variables.
# Use a key from the same Anthropic account (and workspace) that ran `npm run corpus`: uploaded documents belong to it.
ANTHROPIC_API_KEY=

# Optional: where anonymous usage events and survey answers are sent (see docs/staff-guide.md,
# "See how it's doing"). Without it, they only appear in the server log.
FEEDBACK_WEBHOOK_URL=

# Optional, read at build time: space-separated sites allowed to embed MeaningEngine in an iframe.
# Default: https://instituteongenerosity.org https://*.instituteongenerosity.org
EMBED_ALLOWED_ORIGINS=
